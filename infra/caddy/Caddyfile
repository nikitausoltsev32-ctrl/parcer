{
    admin off
}

:80 {
    # API
    handle /api/* {
        reverse_proxy api:8000
    }

    # Tracking pixel (public, no auth)
    handle /t/* {
        reverse_proxy api:8000
    }

    # SPA — все остальные пути
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
