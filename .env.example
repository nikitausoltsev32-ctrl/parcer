# --- Worker DB (procrastinate) ----------------------------
# Для LISTEN/NOTIFY нужно прямое подключение (не pgbouncer).
# Supabase → Project Settings → Database → Connection string → URI (Direct connection).
# Если не задан — воркер использует DATABASE_URL в polling-режиме (работает с pgbouncer).
WORKER_DATABASE_URL=

# --- Security ----------------------------------------------
SECRET_KEY=oPd9wM5xihxwk7YEnedhCajwV47pz3yNQgzr9skUT6dZWQZsGVtTIaX7ZBz7gNrC
FERNET_KEY=jS8OCpERqbJTcfquhqoaFyxSCqdQTjGZPVlF7S28Org=
