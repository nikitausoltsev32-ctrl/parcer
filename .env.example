# --- LLM ---------------------------------------------------
# Chat-агент
LLM_CHAT_PROVIDER=groq
LLM_CHAT_MODEL=llama-3.3-70b-versatile
# Генератор писем
LLM_LETTERS_PROVIDER=qwen
LLM_LETTERS_MODEL=qwen2.5-72b-instruct
# Классификатор inbox
LLM_CLASSIFY_PROVIDER=groq
LLM_CLASSIFY_MODEL=llama-3.1-8b-instant
# Требовать ли согласие юзера (llm_consent_at) перед AI-вызовами
LLM_CONSENT_REQUIRED=true

# Ключи провайдеров
GROQ_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=

# --- Search -----------------------------------------------
TWOGIS_API_KEY=
SERPAPI_KEY=
FIRECRAWL_API_KEY=

# --- Enrichment (опционально) ------------------------------
# Провайдер для анализа сайтов контактов: disabled | qwen | groq | glm | claude
LLM_ENRICH_PROVIDER=disabled
LLM_ENRICH_MODEL=qwen2.5-72b-instruct
# Нужен только если LLM_ENRICH_PROVIDER=claude
ANTHROPIC_API_KEY=

# --- SMTP транзакционные (Unisender Go / Postmark) ---------
TRANSACTIONAL_SMTP_HOST=smtp.unisender.com
TRANSACTIONAL_SMTP_PORT=465
TRANSACTIONAL_SMTP_USER=
TRANSACTIONAL_SMTP_PASS=
TRANSACTIONAL_FROM_EMAIL=noreply@parcer.ru

# --- Мониторинг (опционально) ------------------------------
SENTRY_DSN=
