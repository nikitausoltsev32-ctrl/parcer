# ============================================================
# parcer — .env.example
# Скопируйте в .env и заполните значения. Никогда не коммитьте .env.
# ============================================================

# --- Core --------------------------------------------------
APP_ENV=development
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Supabase (Postgres + Storage) -------------------------
# DATABASE_URL — Supabase → Project Settings → Database → Connection string (URI, Transaction Pooler)
# Формат для SQLAlchemy asyncpg: postgresql+asyncpg://...
DATABASE_URL=postgresql+asyncpg://postgres.dhesdxkzacylwtojnjpj:Usolrasol3101@aws-1-eu-north-1.pooler.supabase.com:5432/postgres?pgbouncer=true
SUPABASE_URL=https://dhesdxkzacylwtojnjpj.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRoZXNkeGt6YWN5bHd0b2puanBqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcyMjYxMzcsImV4cCI6MjA5MjgwMjEzN30.ikdoJXTFjRscRRBn2FhPMYGnjcwdukvfWa7sVCnjyvk
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRoZXNkeGt6YWN5bHd0b2puanBqIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NzIyNjEzNywiZXhwIjoyMDkyODAyMTM3fQ.77fjoyxRKJVtbWxZ3xhUhWbbrfNNwSlBlUHQArj65VE
